# ==========================================================================
#  live2d_api — Apache 安全规则
#  放置位置：live2d_api/ 根目录
#  环境要求：Apache 2.4+，AllowOverride 至少包含 Indexes / FileInfo / Limit / AuthConfig
#           （Apache 2.2 需把 Require all denied 换成 Order deny,allow + Deny from all）
# ==========================================================================

# --------------------------------------------------------------------------
# 1) 关闭目录列表
#    没有 index 文件的目录直接 403，而不是把文件全部列出来
# --------------------------------------------------------------------------
Options -Indexes

# --------------------------------------------------------------------------
# 2) 禁止访问 .git —— 最关键的一条
#    用 git clone 部署到网站目录时，.git 会连同完整历史一起挂在 Web 上：
#    任何人访问 /.git/config、/.git/objects/... 都能还原出源码，
#    而 .git/config 里的 remote URL 还可能带着账号或 token
# --------------------------------------------------------------------------
RedirectMatch 404 (?i)/\.git(/|$)

# --------------------------------------------------------------------------
# 3) 禁止访问所有隐藏文件（.htaccess、.user.ini、.env 等）
# --------------------------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# --------------------------------------------------------------------------
# 4) 禁止访问服务端中间文件
#    textures.cache 只是服务端缓存，前端用不到，没必要暴露
# --------------------------------------------------------------------------
<FilesMatch "(?i)\.(cache|md|log|ini|sh|bak|old|orig|swp|sql|yml|yaml)$">
    Require all denied
</FilesMatch>

# --------------------------------------------------------------------------
# 5) tools/ 下的 php 只是被 require 的类文件，禁止 HTTP 直接访问
# --------------------------------------------------------------------------
RedirectMatch 404 (?i)/tools/

# --------------------------------------------------------------------------
# 6) 跨域响应头（Halo 站点与 apiPath 不同源时必须）
#    插件前端用 XHR 取 model3.json、用 crossOrigin=anonymous 取贴图，
#    缺少下面的响应头会被浏览器直接拦掉，表现为"模型加载失败"。
#    想收紧就把 * 换成站点域名，例如：
#      Header set Access-Control-Allow-Origin "https://blog.example.com"
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# --------------------------------------------------------------------------
# 7) 不要把 PHP 报错吐进响应体
#    报错文本会插在 JSON 前面，导致前端 JSON.parse 失败、模型出不来。
#    用 IfModule 包住：PHP-FPM 环境下没有 mod_php，php_flag 会直接 500
# --------------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors off
</IfModule>

# --------------------------------------------------------------------------
# 8) add/ 会写 textures.cache，属于站长手动调用的维护接口
#    要限制访问就取消注释，并把 IP 换成你自己的
# --------------------------------------------------------------------------
# <If "%{REQUEST_URI} =~ m#/add/#">
#     Require ip 127.0.0.1
# </If>
